{
  "imports": {
    "@apidevtools/swagger-parser": "npm:@apidevtools/swagger-parser@13.1.0",
    "ajv/2020": "npm:ajv@8.20.0/dist/2020.js",
    "ajv-formats": "npm:ajv-formats@3.0.1",
    "js-yaml": "npm:js-yaml@5.5.0",
    "yaml": "./ops/tooling/yaml.ts"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "nodeModulesDir": "none",
  "tasks": {
    "check": "deno check --cached-only supabase/functions/api/*.ts contracts/*.ts ops/tooling/*.ts",
    "test": "deno test --cached-only --no-prompt --allow-read=contracts,fixtures,supabase/config.toml,supabase/functions,ops/release supabase/functions contracts",
    "contracts": "deno run --cached-only --no-prompt --allow-read=contracts,fixtures/release,supabase/functions/api/release.local.json ops/tooling/validate-contracts.ts",
    "db:test": "bash ops/tooling/local-backend.sh test"
  }
}
